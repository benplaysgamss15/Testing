        n2Rot: pr.n2Rot.clone().lerp(cur.n2Rot, a), hRot: pr.hRot.clone().lerp(cur.hRot, a),
        jaw: lerp(pr.jaw, cur.jaw, a), tOut: lerp(pr.tOut, cur.tOut, a), tWhip: lerp(pr.tWhip, cur.tWhip, a),
        tP: pr.tP.map((v, i) => lerp(v, cur.tP[i], a)), tY: pr.tY.map((v, i) => lerp(v, cur.tY[i], a)), tR: pr.tR.map((v, i) => lerp(v, cur.tR[i], a)),
        wL: pr.wL.clone().lerp(cur.wL, a), wR: pr.wR.clone().lerp(cur.wR, a), swL: lerp(pr.swL, cur.swL, a), swR: lerp(pr.swR, cur.swR, a),
      };
    }
    if (this.targetAnim === 'scream' && pose.tOut > 0.45 && this.onScreamPeak) this.onScreamPeak();

    this.bones.pelvis.position.copy(this.pelvisRest).add(pose.pOff);
    this.bones.pelvis.rotation.copy(pose.pRot);
    this.bones.chest.rotation.set(pose.chRot.x, pose.chRot.y, pose.chRot.z);
    this.bones.neck1.rotation.set(pose.n1Rot.x, pose.n1Rot.y, pose.n1Rot.z);
    this.bones.neck2.rotation.set(pose.n2Rot.x, pose.n2Rot.y, pose.n2Rot.z);
    this.bones.headBase.rotation.set(pose.hRot.x, pose.hRot.y, pose.hRot.z);

    this.jawBone.rotation.x = pose.jaw;
    const tE = pose.tOut;
    this.tongueRoot.visible = true;
    this.tongueRoot.position.set(0, 0.024, 0.06 + 0.34 * tE);
    this.tongueRoot.scale.set(0.85 + 0.15 * tE, 0.85 + 0.15 * tE, 0.62 + 0.58 * tE);
    this.tongueRoot.rotation.set(-0.10 - 0.28 * tE + 0.08 * pose.tWhip, 0.14 * pose.tWhip, 0);
    this.tongueProngs.forEach((p, idx) => {
      p.rotation.x = -0.10 * tE + 0.10 * Math.sin(this.time * 14 + idx * 1.4) * (0.15 + tE);
      p.rotation.y = (idx === 0 ? 0.08 : (idx === 1 ? 0.12 : -0.12)) * tE + 0.10 * pose.tWhip;
    });

    const tailOrder = ['tail1','tail2','tail3','tail4','tail5','tail6'];
    tailOrder.forEach((n, i) => this.bones[n].rotation.set(pose.tP[5 - i], pose.tY[5 - i], pose.tR[5 - i], 'YXZ'));
    this.group.updateMatrixWorld(true);
    const tmp = new THREE.Vector3();
    for (let i = 1; i < tailOrder.length; i++) {
      this.bones[tailOrder[i]].getWorldPosition(tmp);
      if (tmp.y < 0.16) { this.bones[tailOrder[i - 1]].rotation.x += Math.min(0.55, (0.16 - tmp.y) * 0.85); this.group.updateMatrixWorld(true); }
    }

    const chP = new THREE.Vector3(), chQ = new THREE.Quaternion();
    this.bones.chest.getWorldPosition(chP); this.bones.chest.getWorldQuaternion(chQ);
    const doIK = (limb, wTgt, sw) => {
      const S = limb.shLocal.clone().applyQuaternion(chQ).add(chP);
      const pole = new THREE.Vector3(limb.side * 0.68, 0.44, -0.76).applyAxisAngle(new THREE.Vector3(0, 1, 0), pose.pRot.y);
      const { E, W, perp } = this._solveIK(S, wTgt, pole);
      const qU = new THREE.Quaternion().setFromRotationMatrix(this._boneMat(S, E, perp));
      const qF = new THREE.Quaternion().setFromRotationMatrix(this._boneMat(E, W, perp));
      limb.shB.quaternion.copy(chQ.clone().invert().multiply(qU));
      limb.elB.quaternion.copy(qU.clone().invert().multiply(qF));
      const qW = new THREE.Quaternion().setFromEuler(new THREE.Euler(0.45 * sw, pose.pRot.y * 0.6, 0, 'YXZ'));
      limb.wrB.quaternion.copy(qF.clone().invert().multiply(qW));
      limb.spurPiv.quaternion.copy(qF.clone().invert().multiply(qU.clone().slerp(qF, 0.42)));
      limb.digits.forEach(d => d.rotation.x = 0.40 * sw);
    };
    doIK(this.limbs.L, pose.wL, pose.swL); doIK(this.limbs.R, pose.wR, pose.swR);
  }
}

const wrap = document.getElementById('canvas-wrap');
const renderer = new THREE.WebGLRenderer({ antialias: true, powerPreference: 'high-performance' });
renderer.setPixelRatio(Math.min(window.devicePixelRatio, 2)); renderer.setSize(window.innerWidth, window.innerHeight);
renderer.shadowMap.enabled = true; renderer.shadowMap.type = THREE.PCFSoftShadowMap;
renderer.toneMapping = THREE.ACESFilmicToneMapping; renderer.toneMappingExposure = 1.06;
wrap.appendChild(renderer.domElement);

const scene = new THREE.Scene(); scene.background = new THREE.Color(0xf1f4f8); scene.fog = new THREE.Fog(0xf1f4f8, 22, 48);
const getFov = (asp) => asp < 1 ? clamp(42 / Math.pow(asp, 0.52), 42, 68) : 42;
const camera = new THREE.PerspectiveCamera(getFov(window.innerWidth / window.innerHeight), window.innerWidth / window.innerHeight, 0.1, 100);
camera.position.set(6.4, 3.1, 4.6);

const controls = new OrbitControls(camera, renderer.domElement);
controls.target.set(0, 1.35, -1.45); controls.enableDamping = true; controls.dampingFactor = 0.06;
controls.minDistance = 2.4; controls.maxDistance = 22; controls.maxPolarAngle = Math.PI * 0.52;
controls.autoRotateSpeed = 1.6; controls.update();

scene.add(new THREE.HemisphereLight(0xffffff, 0xdce3ec, 0.92));
const key = new THREE.DirectionalLight(0xfffaf2, 2.05); key.position.set(6.5, 11, 5.5); key.castShadow = true;
key.shadow.mapSize.set(1024, 1024); key.shadow.camera.near = 1; key.shadow.camera.far = 30;
key.shadow.camera.left = key.shadow.camera.bottom = -8.5; key.shadow.camera.right = key.shadow.camera.top = 8.5;
key.shadow.bias = -0.0005; key.shadow.normalBias = 0.02; scene.add(key);
const fill = new THREE.DirectionalLight(0xe6eef8, 0.78); fill.position.set(-7, 4.5, -5); scene.add(fill);
const rim = new THREE.DirectionalLight(0xffffff, 0.65); rim.position.set(0, 4, -9.5); scene.add(rim);
const bounce = new THREE.DirectionalLight(0xffffff, 0.42); bounce.position.set(0, -4, 2); scene.add(bounce);

const platGrp = new THREE.Group(); platGrp.position.set(0, 0, -1.6); scene.add(platGrp);
const platR = 7.8, platH = 0.36;
const platMesh = new THREE.Mesh(
  new THREE.CylinderGeometry(platR, platR + 0.16, platH, 80),
  [new THREE.MeshStandardMaterial({ color: 0xe6eaf0, roughness: 0.55 }), new THREE.MeshStandardMaterial({ color: 0xffffff, roughness: 0.72 }), new THREE.MeshStandardMaterial({ color: 0xe6eaf0 })]
);
platMesh.position.y = -platH / 2; platMesh.receiveShadow = platMesh.castShadow = true; platGrp.add(platMesh);
const rimGeo = new THREE.RingGeometry(platR - 0.08, platR, 80); rimGeo.rotateX(-Math.PI / 2);
const rimMesh = new THREE.Mesh(rimGeo, new THREE.MeshBasicMaterial({ color: 0xd5dce4 })); rimMesh.position.y = 0.002; platGrp.add(rimMesh);

const ringsGrp = new THREE.Group();
[1.8, 3.6, 5.4, 7.2].forEach(r => { const rg = new THREE.RingGeometry(r - 0.015, r + 0.015, 80); rg.rotateX(-Math.PI / 2); const m = new THREE.Mesh(rg, new THREE.MeshBasicMaterial({ color: 0xe2e7ee })); m.position.y = 0.003; ringsGrp.add(m); });
platGrp.add(ringsGrp);

const floor = new THREE.Mesh(new THREE.PlaneGeometry(140, 140).rotateX(-Math.PI / 2), new THREE.MeshStandardMaterial({ color: 0xeef2f6, roughness: 0.92 }));
floor.position.y = -platH; floor.receiveShadow = true; scene.add(floor);

const skullcrawler = new SkullcrawlerModel(); scene.add(skullcrawler.group);
const roar = new RoarSynth(); skullcrawler.onScreamPeak = () => roar.trigger();

document.querySelectorAll('.anim-btn').forEach(b => b.addEventListener('click', () => {
  document.querySelectorAll('.anim-btn').forEach(x => x.classList.remove('active')); b.classList.add('active');
  skullcrawler.setAnimation(b.dataset.anim);
}));
const spSlider = document.getElementById('speed-slider'), spVal = document.getElementById('speed-val');
spSlider.addEventListener('input', () => { skullcrawler.speed = parseFloat(spSlider.value); spVal.textContent = skullcrawler.speed.toFixed(1) + 'x'; });

const camPresets = {
  hero:  { p: [6.4, 3.1, 4.6],   t: [0, 1.35, -1.45] },
  front: { p: [0, 2.1, 6.8],     t: [0, 1.45,  0.20] },
  side:  { p: [9.2, 2.2, -1.8],  t: [0, 1.25, -1.80] },
  back:  { p: [-2.6, 2.6, -10.4],t: [0, 1.20, -2.00] },
  top:   { p: [0, 12.2, -1.6],   t: [0, 0.50, -1.70] },
};
let tween = null;
document.querySelectorAll('[data-cam]').forEach(b => b.addEventListener('click', () => {
  document.querySelectorAll('[data-cam]').forEach(x => x.classList.remove('active')); b.classList.add('active');
  const c = camPresets[b.dataset.cam];
  tween = { t: 0, fp: camera.position.clone(), tp: new THREE.Vector3(...c.p), ft: controls.target.clone(), tt: new THREE.Vector3(...c.t) };
}));

const btnSpin = document.getElementById('btn-turntable');
btnSpin.addEventListener('click', () => { controls.autoRotate = !controls.autoRotate; btnSpin.classList.toggle('active', controls.autoRotate); });
const btnRings = document.getElementById('btn-rings');
btnRings.addEventListener('click', () => { ringsGrp.visible = !ringsGrp.visible; btnRings.classList.toggle('active', ringsGrp.visible); });
const btnSound = document.getElementById('btn-sound');
btnSound.addEventListener('click', () => { roar.setEnabled(!roar.on); btnSound.classList.toggle('active', roar.on); if (roar.on && skullcrawler.targetAnim === 'scream') roar.trigger(); });
const btnInfo = document.getElementById('btn-info'), drawer = document.getElementById('info-drawer');
btnInfo.addEventListener('click', () => { btnInfo.classList.toggle('active', drawer.classList.toggle('open')); });

window.addEventListener('resize', () => {
  const asp = window.innerWidth / window.innerHeight;
  camera.aspect = asp; camera.fov = getFov(asp); camera.updateProjectionMatrix();
  renderer.setSize(window.innerWidth, window.innerHeight);
});

let last = performance.now();
(function loop(now) {
  requestAnimationFrame(loop);
  const dt = Math.min(0.05, (now - last) / 1000); last = now;
  skullcrawler.update(dt);
  if (tween) {
    tween.t = Math.min(1, tween.t + dt * 2.6);
    const s = tween.t * tween.t * (3 - 2 * tween.t);
    camera.position.lerpVectors(tween.fp, tween.tp, s);
    controls.target.lerpVectors(tween.ft, tween.tt, s);
    if (tween.t >= 1) tween = null;
  }
  controls.update(); renderer.render(scene, camera);
})(last);
</script>
</body>
</html>
