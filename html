  }
  dCtx.putImageData(dImg, 0, 0); bCtx.putImageData(bImg, 0, 0); rCtx.putImageData(rImg, 0, 0);
  const tx = (c, srgb) => { const t = new THREE.CanvasTexture(c); t.wrapS = t.wrapT = THREE.RepeatWrapping; t.repeat.set(3, 3); if (srgb) t.colorSpace = THREE.SRGBColorSpace; return t; };
