      const flank = Math.exp(-0.5 * ((Math.abs(sT) - 0.80) / 0.28) ** 2) * smoothstep(-0.5, 0.5, cT);
      const shMask = Math.exp(-0.5 * (((iEff - iMid) / (0.85 * dI)) ** 2 + ((sideJ - jMidL) / (0.75 * dJ)) ** 2));
