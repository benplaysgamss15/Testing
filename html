    this._buildHead(this.bones.headBase);
  }

  _buildBodyAndLimbsGeo(ctrlS, ctrlZ, ctrlY, stationS, chestW) {
    const nAx = 92, nRd = 32;
    const i0 = 68, i1 = 76, j0L = 6, j1L = 13;
    const j0R = nRd - j1L, j1R = nRd - j0L;
    const dI = i1 - i0, dJ = j1L - j0L;
