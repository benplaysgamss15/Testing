  .title-card p { font-size: 11.5px; color: #52606e; margin-top: 3px; line-height: 1.35; }

  .hud-right { position: fixed; top: 12px; right: 12px; z-index: 10; display: flex; flex-direction: column; align-items: flex-end; gap: 6px; }
  .cam-panel {
    display: flex; flex-wrap: wrap; gap: 4px; justify-content: flex-end;
