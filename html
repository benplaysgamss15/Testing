  #canvas-wrap { position: fixed; inset: 0; touch-action: none; }
  canvas { display: block; width: 100%; height: 100%; touch-action: none; }

  .hud-top { position: fixed; top: 12px; left: 12px; z-index: 10; pointer-events: none; }
  .title-card {
    pointer-events: auto; background: rgba(255,255,255,0.88); backdrop-filter: blur(12px);
    border: 1px solid rgba(28,34,41,0.1); border-radius: 12px; padding: 10px 14px;
    box-shadow: 0 6px 24px rgba(15,23,42,0.08); max-width: 310px;
  }
  .badge { display: inline-block; font-size: 10px; font-weight: 700; letter-spacing: 0.07em; text-transform: uppercase; color: #4f5d6b; background: #e8edf2; padding: 2px 7px; border-radius: 999px; margin-bottom: 4px; }
