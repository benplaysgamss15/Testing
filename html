      lx += Math.sign(sT) * rib;
      ln += 0.045 * Math.exp(-0.5 * ((sEff - 0.56) / 0.08) ** 2) * Math.max(0, -cT);
      if (barb > 0 && cT > 0.65) ln += 0.065 * barb * ((cT - 0.65) / 0.35) ** 1.4;

      const shFlare = Math.exp(-0.5 * (((iEff - iMid) / (1.35 * dI)) ** 2 + ((sideJ - jMidL) / (0.95 * dJ)) ** 2));
      if (Math.abs(sT) > 0.05) {
