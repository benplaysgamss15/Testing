    display: flex; flex-wrap: wrap; align-items: center; justify-content: center; gap: 6px;
    background: rgba(255,255,255,0.92); backdrop-filter: blur(14px);
    border: 1px solid rgba(28,34,41,0.1); border-radius: 15px; padding: 8px 10px;
    box-shadow: 0 10px 30px rgba(15,23,42,0.1); max-width: calc(100vw - 16px);
